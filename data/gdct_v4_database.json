    {
      "id": "content-1787625260470-103",
      "lessonId": "lesson-1787625236320",
      "order": 1,
      "title": "1. Lời Bác Hồ căn dặn xây dựng Tổ chức Đảng và Đoàn kết nội bộ",
      "bodyHtml": "<p><strong>Nội dung trọng tâm:</strong></p>\n<p>Xây dựng tổ chức Đảng trong sạch, vững mạnh là nhân tố quyết định mọi thắng lợi của lực lượng vũ trang nhân dân nói chung và Quân chủng Hải quân nói riêng.</p>\n<p>Mỗi đảng viên, đoàn viên, cán bộ, chiến sĩ phải thấm nhuần sâu sắc nguyên tắc tập trung dân chủ, tinh thần tự phê bình và phê bình, giữ gìn sự đoàn kết thống nhất như giữ gìn con ngươi của mắt mình.</p>",
      "keyPoints": [
        "Đoàn kết là sức mạnh",
        "Tự phê bình và phê bình",
        "Gương mẫu đi đầu"
      ],
      "quote": "Đoàn kết, đoàn kết, đại đoàn kết. Thành công, thành công, đại thành công.",
      "quoteAuthor": "Chủ tịch Hồ Chí Minh",
      "quoteHistoricalContext": "Chủ tịch Hồ Chí Minh luôn nhấn mạnh bài học đoàn kết là cội nguồn của mọi thắng lợi trong sự nghiệp đấu tranh giải phóng dân tộc và bảo vệ toàn vẹn lãnh thổ.",
      "isUncleHoTeaching": true,
      "quoteQuiz": {
        "enabled": true,
        "question": "Để thực hiện tốt lời dạy của Bác Hồ về đoàn kết trong toàn đơn vị, hành động nào dưới đây là chuẩn mực hàng đầu của mỗi cán bộ, chiến sĩ?",
        "options": [
          "Gương mẫu chấp hành nghiêm kỷ luật quân đội, thương yêu giúp đỡ đồng chí đồng đội cùng tiến bộ, hiệp đồng chặt chẽ trong mọi nhiệm vụ",
          "Chỉ hoàn thành nhiệm vụ của cá nhân mình, không cần quan tâm đến đồng đội",
          "Giữ kín ý kiến cá nhân, không tham gia sinh hoạt chi bộ",
          "Tùy ý phát ngôn trên mạng xã hội khi ra biển trực chiến"
        ],
        "correctOptionIndex": 0,
        "explanation": "Chính xác! Lời dạy của Bác Hồ đòi hỏi mỗi quân nhân phải phát huy cao độ tinh thần tương thân tương ái, kỷ luật tự giác, gắn bó máu thịt trong tập thể tàu và đơn vị.",
        "rewardProgressPercent": 100
