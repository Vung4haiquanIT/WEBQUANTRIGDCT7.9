          "maxLength": 500
        },
        "order": {
          "type": "number",
          "description": "Thứ tự bài học trong chuyên đề"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "REVIEW", "PUBLISHED", "ARCHIVED"],
          "description": "Trạng thái phát hành"
        },
        "version": {
          "type": "number",
          "description": "Phiên bản bài học (tăng khi sửa đổi slide, nội dung hoặc media)"
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Đánh dấu xóa mềm"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Thời lượng học tập dự kiến (phút)"
