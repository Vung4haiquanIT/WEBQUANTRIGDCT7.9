        "version": {
          "type": "number",
          "description": "Phiên bản slide"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời gian tạo"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời gian cập nhật"
        }
      },
      "required": ["id", "lessonId", "order", "imageUrl", "version", "createdAt", "updatedAt"]
    },
