        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm tạo"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cập nhật"
        }
      },
      "required": ["id", "courseId", "title", "status", "version", "createdAt", "updatedAt"]
    },
    "Slide": {
      "title": "Slide",
