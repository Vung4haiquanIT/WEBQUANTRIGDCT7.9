          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "courseId": {
          "type": "string",
          "description": "Mã chuyên đề cha",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Tiêu đề bài học",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Mô tả nội dung bài học",
          "maxLength": 2000
        },
        "thumbnail": {
          "type": "string",
          "description": "URL ảnh đại diện bài học",
          "maxLength": 1000
