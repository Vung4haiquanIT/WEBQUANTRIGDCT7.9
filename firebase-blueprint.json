    "Course": {
      "title": "Course",
      "description": "Chuyên đề Giáo dục chính trị Quân sự Vùng 4 Hải Quân",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Mã định danh chuyên đề",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Tiêu đề chuyên đề",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Tóm tắt chuyên đề",
          "maxLength": 2000
        },
        "thumbnail": {
          "type": "string",
          "description": "URL hình ảnh đại diện",
          "maxLength": 1000
        },
        "storageThumbnailPath": {
          "type": "string",
          "description": "Đường dẫn Cloud Storage thumbnail",
          "maxLength": 500
        },
        "year": {
          "type": "number",
          "description": "Năm huấn luyện giáo dục chính trị"
        },
        "order": {
          "type": "number",
          "description": "Thứ tự sắp xếp chuyên đề"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "REVIEW", "PUBLISHED", "ARCHIVED"],
          "description": "Trạng thái phát hành"
        },
        "version": {
          "type": "number",
          "description": "Phiên bản chuyên đề (tự động tăng khi cập nhật)"
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Đánh dấu xóa mềm"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 150,
          "description": "Cơ quan/Cán bộ biên soạn"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời gian khởi tạo"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời gian cập nhật gần nhất"
        }
      },
      "required": ["id", "title", "status", "version", "createdAt", "updatedAt"]
    },
    "Lesson": {
